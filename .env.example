# Nova Graphik backend configuration
# Copy to .env and adjust. The .env file is git-ignored.

# Port the API (and, in production, the built site) is served on.
PORT=3001

# Secret used to sign JWT session tokens. MUST be a long random string in prod.
JWT_SECRET=change-me-to-a-long-random-string

# Credentials of the admin account seeded on first run.
# Change the password after first login in production.
ADMIN_EMAIL=gggg
ADMIN_PASSWORD=ggg!
