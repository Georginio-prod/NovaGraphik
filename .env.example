# Nova Graphik backend configuration
# Copy to .env and fill in. The .env file is git-ignored.

# Port the API (and, in production, the built site) is served on.
PORT=3001

# ----------------------------------------------------------------------------
# Supabase Auth
# Trouvez ces valeurs dans votre projet Supabase
# (Dashboard → Project Settings → API) :
# ----------------------------------------------------------------------------
# Public URL of the project (https://<ref>.supabase.co)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Public anon key (long JWT string), safe to expose to the browser.
VITE_SUPABASE_ANON_KEY=

# JWT secret used by Supabase to sign access tokens (Settings → API → JWT settings).
# Used server-side to verify incoming tokens on /api/admin/* routes.
SUPABASE_JWT_SECRET=
