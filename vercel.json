{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://VOTRE-BACKEND.onrender.com/api/:path*" },
    { "source": "/uploads/:path*", "destination": "https://VOTRE-BACKEND.onrender.com/uploads/:path*" },
    { "source": "/((?!_next|api|uploads|favicon|assets|icons).*)", "destination": "/index.html" }
  ]
}
