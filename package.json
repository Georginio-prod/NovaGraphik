{
  "name": "novagraphik",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "app",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -k -n app,api -c green,cyan \"npm -w @novagraphik/app run dev\" \"npm -w @novagraphik/backend run dev\"",
    "dev:app": "npm -w @novagraphik/app run dev",
    "dev:api": "npm -w @novagraphik/backend run dev",
    "build": "npm -w @novagraphik/app run build",
    "start:app": "npm -w @novagraphik/app run start",
    "start:api": "npm -w @novagraphik/backend run start"
  },
  "devDependencies": {
    "concurrently": "^10.0.0"
  }
}
