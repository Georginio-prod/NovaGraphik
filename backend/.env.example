# Backend env (Express)
# Port the API listens on. The server reads process.env.PORT (see src/index.js).
# Locally: 3001. On Railway: DO NOT set this — Railway injects PORT automatically
# and the server already binds to it.
PORT=3001

# Supabase — used to verify access tokens against the project's JWKS endpoint
# at https://<ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_URL=https://your-project.supabase.co

# Optional overrides for prod (Railway volume mount, etc.):
# DB_PATH=/data/data.sqlite
# UPLOADS_DIR=/data/uploads
# STATIC_DIR=/app/app/dist   # only for monolithic prod test
