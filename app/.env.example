# Frontend env (loaded by Vite — only variables prefixed VITE_ reach the bundle)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: full backend URL, ONLY needed when the API is on a different origin.
# - Monolithic deploy (one Railway service, backend serves app/dist): LEAVE EMPTY.
#   The app then calls /api on the same origin — nothing to configure.
# - Two separate services: set this to the deployed backend root, e.g.
#     VITE_API_BASE_URL=https://novagraphik-backend.up.railway.app
#   (do NOT add /api at the end — the helper adds it)
# In dev it stays empty (Vite proxies /api → backend on localhost:3001).
VITE_API_BASE_URL=
