# Frontend env (loaded by Vite — only variables prefixed VITE_ reach the bundle).
# Architecture cible: le front parle DIRECTEMENT à Supabase (Postgres + Storage),
# il n'y a plus de backend à configurer.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Storage bucket public pour les médias (images & vidéos). Doit correspondre au
# bucket créé par supabase/schema.sql.
VITE_SUPABASE_BUCKET=media

# EmailJS — e-mail de devis brandé (logo Nova) envoyé à contact@novagraphik.fr.
# Crée un compte gratuit sur emailjs.com → connecte une boîte mail (service) →
# crée un template (voir EMAIL_SETUP.md) → copie les 3 identifiants ci-dessous.
# Si ces variables sont absentes, le formulaire bascule sur FormSubmit (sans logo).
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
